# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# OpenRouter — create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# tool: web_search provider API key. You.com is preferred when both are set — https://ydc-index.io.
# Optional: without either, every tool works except web_search, which returns a clear
# "not configured" error when called.
YOU_SEARCH_API_KEY=
# Fallback web_search provider — https://api.search.brave.com.
BRAVE_SEARCH_API_KEY=

# tool: path to an operator-written file of declarative tool rows (see
# services/tool/README.md#declarative-tools). Optional — unset, the service starts with none
# loaded. Not wired into compose.yaml: the bind-mount would be awkward when the file does not
# exist (Compose creates a directory in its place), so it is applied with a `docker compose`
# override at `up` time instead, documented in that README. Left empty here since it names a
# host path, not a secret.
#DECLARATIVE_TOOLS_PATH=/etc/tool/declarative-tools.json

# engine: the slug of the tool the built-in `rag` graph retrieves with. Which tool retrieves is the
# Tool service's to own and an operator's to withdraw, so naming it in Rust would register a graph
# node pointing at a slug `built-in-tools.json` can take out of the catalog. Unset, the `rag` graph
# is not registered at all; the `agent` graph the chat path uses does not need it.
#RAG_RETRIEVAL_TOOL_SLUG=kb_search

# tool: path to an operator-written file saying what the tools compiled into the binary cover, and
# which of them are in circulation. Same shape of decision as the file above, and the same optional
# bind-mount. Two things live here rather than in Rust: a source's subject matter, because the
# repository forbids naming a subject in code, and whether a source is answerable at all, because
# that is an operating decision. What a file leaves out keeps what the binary declares.
#   {"kb_search": {"description": "..."}, "web_search": {"enabled": false}}
#BUILT_IN_TOOLS_PATH=/etc/tool/built-in-tools.json

# Tier -> model. Each backup is a different vendor, so one provider's outage cannot take a tier down.
# Slugs move: re-check against https://openrouter.ai/models before changing these.
# The low tier is not automatically the cheap tier. What runs on it here is short and sits on a
# user-facing critical path, where a cheaper token price saves fractions of a cent on a few dozen
# output tokens and a slower model costs most of a second. Measured on this deployment: the same
# call took 1405/1305/1232 ms on one model and 444/539/550 ms on another, same prompt. Pick a low
# model for what actually runs there, and re-measure rather than assuming the cheaper one is fine.
LLM_LOW_PRIMARY=deepseek/deepseek-v4.1-flash
LLM_LOW_BACKUP=z-ai/glm-4.7-flash
LLM_MEDIUM_PRIMARY=deepseek/deepseek-v4.1-flash
LLM_MEDIUM_BACKUP=deepseek/deepseek-v3.2
LLM_HIGH_PRIMARY=z-ai/glm-5
LLM_HIGH_BACKUP=deepseek/deepseek-r1-0528

# Optional. A JSON object, opaque to llm-router, forwarded verbatim as the `provider` field of
# every completion request — the operator picks the shape their upstream documents. Unset, the
# request body is unchanged from today. Malformed JSON, or JSON that isn't an object, fails
# startup the same way a rejected OPENROUTER_API_KEY does.
#LLM_PROVIDER_ROUTING_JSON={"sort":"latency","require_parameters":true}

# Each tier's limits are part of its published contract, not deployment config: see services/llm-router/src/llm.rs.

# llm-router, structured decisions: TypeSafe AI's System One API — https://docs.typesafe.ai/api.
# A different class of model from the tiers above. It answers typed questions about a state with
# calibrated probabilities instead of generating text, so a routing or triage decision arrives as a
# number your code can branch on. Create a key at https://console.typesafe.ai/settings/keys.
# Leave it EMPTY and llm-router still starts: every RPC works except Decide and DescribeModels,
# which answer a clear "not configured" error when called. Set it to a value the provider rejects
# and the container fails at startup, the same as a wrong OPENROUTER_API_KEY — so leave it empty
# rather than parking a placeholder here.
TYPESAFE_AI_API_KEY=
# Both optional. Pin an exact version, never an alias: every threshold in Engine and Chat was
# calibrated against one version, and an alias that moves relocates all of them silently — the
# numbers are in docs/decision-calibration.md and have to be replayed on any bump. jev-latest is
# the flagship alias and jev-preview the newest build; use either only to discover what to pin.
# PIN A CONCRETE VERSION once you have tuned confidence thresholds against one — the vendor says so
# itself, and this deployment has several tuned thresholds already. An alias moves on the vendor's
# schedule, and the new version behind it reprices every threshold at once with nothing failing to
# say so. Note that nothing validates this value: llm-router passes it through, and its startup
# probe checks the key alone, so a typo here reaches a healthy container and fails on the first
# decision. Confirm a change by sending a turn and reading llm_router.decisions.model_used.
TYPESAFE_AI_BASE_URL=https://api.typesafe.ai
TYPESAFE_AI_MODEL=jev-1.13.0

# Crawler: most pages fetched per crawl, in or out of scope (ceiling 10000).
CRAWL_MAX_PAGES=10000

# Gateway: the one password that gates the whole app (see gateway/README.md#authentication).
# Unlike the DB passwords below, this one is meant to stay fixed and be shared with the whole
# team — everyone sets the same value in their own .env. Pick something memorable, not a random
# string; share the value itself out-of-band (Slack, a password manager), never in git.
GATEWAY_AUTH_PASSWORD=change-me
# How long a session lasts before a re-login is required. Optional, defaults to 24.
GATEWAY_SESSION_TTL_HOURS=24

# Engine: how long a finished execution's row and checkpoints stay in the hot tables before the
# sweep deletes them, in seconds. Optional, defaults to 3600 (one hour) — long enough for the
# client that started it to fetch the result with GetExecution. After that GetExecution answers
# NotFound and StreamEvents is the way to read the run's history; the events themselves are never
# swept. Shorter keeps the working set smaller, longer keeps results reachable for longer.
ENGINE_TERMINAL_RETENTION=3600
# How many months of engine.execution_events to keep. Deliberately left unset: the event log is
# the durable history everything else in engine is swept against, so it is kept forever unless
# somebody decides otherwise. When set (e.g. 12), the daily maintenance pass DROPs whole monthly
# partitions that fell out of the window — it never DELETEs rows.
#ENGINE_EVENTS_RETENTION_MONTHS=12

# Chat
# How many months of chat.events to keep. Same shape and same default as the engine setting above:
# unset means keep forever, and when set the daily maintenance pass DROPs whole monthly partitions
# rather than DELETEing rows. chat.events is what a browser replays on load, so a window shorter
# than the sessions people still open loses their transcript.
#CHAT_EVENTS_RETENTION_MONTHS=12

# Postgres: one instance, one schema and role per service (.agents/skills/code-review/gate-database/schema-isolation.md).
# The superuser only bootstraps schemas and roles; each service connects as its own role:
#   postgres://<service>_user:<SERVICE>_DB_PASSWORD@postgres:5432/app
# Generate real values with: openssl rand -hex 24 (hex stays URL-safe inside DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
CRAWLER_DB_PASSWORD=change-me
GATEWAY_DB_PASSWORD=change-me
LLM_ROUTER_DB_PASSWORD=change-me
KNOWLEDGE_BASE_DB_PASSWORD=change-me
ENGINE_DB_PASSWORD=change-me
TOOL_DB_PASSWORD=change-me
CHAT_DB_PASSWORD=change-me

# knowledge-base: the native embedder (native/embedder-ane) on the Mac host.
EMBEDDER_URL=http://host.docker.internal:8086

# Cargo profile for service images: dev (fast local rebuilds) or release (shipped builds).
BUILD_PROFILE=dev
