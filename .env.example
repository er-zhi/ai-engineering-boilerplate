# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# OpenRouter — create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# tool: web_search provider API key. You.com is preferred when both are set — https://ydc-index.io.
# Optional: without either, every tool works except web_search, which returns a clear
# "not configured" error when called.
YOU_SEARCH_API_KEY=
# Fallback web_search provider — https://api.search.brave.com.
BRAVE_SEARCH_API_KEY=

# Tier -> model. Each backup is a different vendor, so one provider's outage cannot take a tier down.
# Slugs move: re-check against https://openrouter.ai/models before changing these.
LLM_LOW_PRIMARY=deepseek/deepseek-v4-flash
LLM_LOW_BACKUP=z-ai/glm-4.7-flash
LLM_MEDIUM_PRIMARY=deepseek/deepseek-v3.2
LLM_MEDIUM_BACKUP=z-ai/glm-4.7
LLM_HIGH_PRIMARY=z-ai/glm-5
LLM_HIGH_BACKUP=deepseek/deepseek-r1-0528

# Each tier's limits are part of its published contract, not deployment config: see common/src/llm.rs.

# Crawler: most pages fetched per crawl, in or out of scope (ceiling 10000).
CRAWL_MAX_PAGES=10000

# Gateway: the one password that gates the whole app (see gateway/README.md#authentication).
# Unlike the DB passwords below, this one is meant to stay fixed and be shared with the whole
# team — everyone sets the same value in their own .env. Pick something memorable, not a random
# string; share the value itself out-of-band (Slack, a password manager), never in git.
GATEWAY_AUTH_PASSWORD=change-me
# How long a session lasts before a re-login is required. Optional, defaults to 24.
GATEWAY_SESSION_TTL_HOURS=24

# Engine: how long a finished execution's row and checkpoints stay in the hot tables before the
# sweep deletes them, in seconds. Optional, defaults to 3600 (one hour) — long enough for the
# client that started it to fetch the result with GetExecution. After that GetExecution answers
# NotFound and StreamEvents is the way to read the run's history; the events themselves are never
# swept. Shorter keeps the working set smaller, longer keeps results reachable for longer.
ENGINE_TERMINAL_RETENTION=3600
# How many months of engine.execution_events to keep. Deliberately left unset: the event log is
# the durable history everything else in engine is swept against, so it is kept forever unless
# somebody decides otherwise. When set (e.g. 12), the daily maintenance pass DROPs whole monthly
# partitions that fell out of the window — it never DELETEs rows.
#ENGINE_EVENTS_RETENTION_MONTHS=12

# Postgres: one instance, one schema and role per service (.agents/skills/code-review/gate-database/schema-isolation.md).
# The superuser only bootstraps schemas and roles; each service connects as its own role:
#   postgres://<service>_user:<SERVICE>_DB_PASSWORD@postgres:5432/app
# Generate real values with: openssl rand -hex 24 (hex stays URL-safe inside DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
CRAWLER_DB_PASSWORD=change-me
GATEWAY_DB_PASSWORD=change-me
LLM_ROUTER_DB_PASSWORD=change-me
KNOWLEDGE_BASE_DB_PASSWORD=change-me
ENGINE_DB_PASSWORD=change-me
TOOL_DB_PASSWORD=change-me
CHAT_DB_PASSWORD=change-me

# knowledge-base: the native embedder (native/embedder-ane) on the Mac host.
EMBEDDER_URL=http://host.docker.internal:8086
